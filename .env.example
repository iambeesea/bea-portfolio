# Copy to .env.local for local development, and add the same values in
# Vercel -> Project -> Settings -> Environment Variables.

# Public address of the deployed site (no trailing slash). Used for canonical
# URLs, the sitemap and link previews.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Supabase -> Project Settings -> API. Safe to expose: Row Level Security
# limits this key to reading published content.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase -> Project Settings -> API -> service_role. SECRET. Server only:
# used by the contact form to store messages. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Any long random string; salts the hashed sender address used for
# contact form rate limiting. Defaults to the service role key.
CONTACT_IP_SALT=

# Optional. Resend API key (resend.com -> API Keys). SECRET. When set, each new
# contact message is also emailed to you.
RESEND_API_KEY=

# Optional. Where notifications go (defaults to the email in lib/site.ts) and
# who they come from (needs a domain verified in Resend).
CONTACT_NOTIFY_EMAIL=
CONTACT_FROM_EMAIL=
